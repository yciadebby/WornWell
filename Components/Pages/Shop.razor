@page "/shop"
@rendermode InteractiveServer
@inject Supabase.Client Db
@using static Supabase.Postgrest.Constants
@using WornWell.Models

<div class="min-h-screen flex flex-col w-full bg-[#f5f3ef] text-[#1A1A1A] font-sans selection:bg-[#A35C46] selection:text-white">
    
    <!-- Navigation -->
    <header class="sticky top-0 z-50 bg-[#f5f3ef] flex items-center justify-between py-6 px-8 md:px-16 border-b border-black/5">
        <a href="/" class="font-serif font-bold text-xl tracking-tight text-[#1A1A1A] hover:text-[#A35C46] transition-colors">Worn Well</a>
        
        <nav class="hidden md:flex gap-8 absolute left-1/2 -translate-x-1/2">
            <a href="/" class="text-[0.8rem] font-medium text-[#666] hover:text-[#A35C46] transition-colors">Home</a>
            <a href="/shop" class="text-[0.8rem] font-medium text-[#A35C46]">Shop</a>
            <a href="/story" class="text-[0.8rem] font-medium text-[#666] hover:text-[#A35C46] transition-colors">About</a>
        </nav>

        <div class="flex items-center gap-5">
            <button class="text-[#1A1A1A] hover:text-[#A35C46] transition-colors">
                <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
            </button>
            <button class="relative text-[#1A1A1A] hover:text-[#A35C46] transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
                <span class="absolute -top-1.5 -right-2 bg-[#A35C46] text-white text-[0.6rem] px-[5px] py-[1px] rounded-full font-medium">0</span>
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 px-8 md:px-16 pb-24">
        
        <!-- Header -->
        <div class="pt-12 pb-8">
            <span class="text-[0.65rem] font-bold tracking-[0.2em] text-[#A35C46] uppercase mb-4 block">340+ Pieces</span>
            <h1 class="text-5xl lg:text-[4rem] font-serif font-light text-[#1A1A1A]">
                Browse the <em class="italic">rack.</em>
            </h1>
        </div>

        <!-- Filter Bar -->
        <div class="border-y border-black/10 py-5 flex flex-col md:flex-row md:items-center justify-between text-[0.65rem] gap-6">
            <div class="flex flex-col md:flex-row md:items-center gap-6 lg:gap-10">
                
                <!-- Category Filters -->
                <div class="flex items-center gap-4">
                    <span class="font-bold tracking-[0.15em] uppercase text-[#888]">Category</span>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var cat in categories)
                        {
                            <button @onclick="() => selectedCategory = cat" class="@GetButtonClass(selectedCategory == cat)">
                                @cat
                            </button>
                        }
                    </div>
                </div>

                <!-- Condition Filters -->
                <div class="flex items-center gap-4">
                    <span class="font-bold tracking-[0.15em] uppercase text-[#888]">Condition</span>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var cond in conditions)
                        {
                            <button @onclick="() => selectedCondition = cond" class="@GetButtonClass(selectedCondition == cond)">
                                @cond
                            </button>
                        }
                    </div>
                </div>

            </div>
            <span class="text-[#888] font-medium tracking-wide">@FilteredItems.Count @(FilteredItems.Count == 1 ? "item" : "items")</span>
        </div>

        <!-- Add New Thrift Item Form -->
        <div class="border-b border-black/10 py-5 flex flex-wrap items-center gap-3 text-[0.75rem]">
            <span class="font-bold tracking-[0.15em] uppercase text-[0.65rem] text-[#888] mr-2">Add Piece</span>

            <input @bind="newTitle"
                   placeholder="Item title (e.g. Vintage Denim Jacket)"
                   class="bg-white/70 border border-black/15 px-3 py-1.5 text-[#1A1A1A] placeholder:text-[#888] focus:outline-none focus:border-[#1A1A1A] min-w-[210px]" />

            <select @bind="newCategory"
                    class="bg-white/70 border border-black/15 px-3 py-1.5 text-[#1A1A1A] focus:outline-none focus:border-[#1A1A1A]">
                <option value="Outerwear">Outerwear</option>
                <option value="Tops">Tops</option>
                <option value="Bottoms">Bottoms</option>
                <option value="Dresses">Dresses</option>
            </select>

            <input @bind="newSizeLabel"
                   placeholder="Size (e.g. Size M)"
                   class="w-28 bg-white/70 border border-black/15 px-3 py-1.5 text-[#1A1A1A] placeholder:text-[#888] focus:outline-none focus:border-[#1A1A1A]" />

            <select @bind="newCondition"
                    class="bg-white/70 border border-black/15 px-3 py-1.5 text-[#1A1A1A] focus:outline-none focus:border-[#1A1A1A]">
                <option value="Excellent">Excellent</option>
                <option value="Good">Good</option>
                <option value="Fair">Fair</option>
            </select>

            <input @bind="newPrice"
                   type="number"
                   placeholder="Price"
                   class="w-28 bg-white/70 border border-black/15 px-3 py-1.5 text-[#1A1A1A] placeholder:text-[#888] focus:outline-none focus:border-[#1A1A1A]" />

            <button @onclick="Add"
                    disabled="@saving"
                    class="bg-[#A35C46] text-white px-5 py-1.5 font-medium tracking-wide hover:bg-[#8c4c38] transition-colors disabled:opacity-50">
                @(saving ? "Adding..." : "Add")
            </button>
        </div>
        
        <!-- Product Grid -->
        @if (isLoading)
        {
            <div class="py-20 text-center text-sm text-[#888]">Loading rack...</div>
        }
        else if (FilteredItems.Count == 0)
        {
            <div class="py-20 text-center text-sm text-[#888]">No pieces match your current filters.</div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12 mt-10">
                @foreach (var item in FilteredItems)
                {
                    <div class="flex flex-col group">
                        <!-- Image Container -->
                        <div class="relative aspect-[4/5] mb-4 bg-[#e8e4de] border border-black/5 overflow-hidden">
                            <span class="absolute top-3 left-3 bg-[#f5f3ef]/90 text-[#A35C46] border border-[#A35C46]/30 text-[0.55rem] font-bold tracking-widest px-2 py-0.5 z-10 uppercase">
                                @item.Condition
                            </span>
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            }
                        </div>

                        <div class="flex justify-between items-start">
                            <div class="flex flex-col">
                                <h3 class="text-[0.85rem] font-serif font-bold text-[#1A1A1A] mb-1">@item.Title</h3>
                                <div class="text-[0.65rem] text-[#888] flex gap-2">
                                    <span class="capitalize">@item.Category.ToLower()</span>
                                    <span>&bull;</span>
                                    <span>@item.SizeLabel</span>
                                </div>
                            </div>
                            <div class="flex flex-col items-end">
                                <span class="font-serif font-bold text-[0.85rem] text-[#1A1A1A]">@($"P{item.Price:N0}")</span>
                                @if (item.OriginalPrice.HasValue && item.OriginalPrice > item.Price)
                                {
                                    <span class="text-[0.65rem] text-[#888] line-through">@($"P{item.OriginalPrice.Value:N0}")</span>
                                }
                            </div>
                        </div>

                        <!-- Step 8: Update & Soft Delete Actions -->
                        <div class="flex gap-2 mt-3 pt-2.5 border-t border-black/10 text-[0.65rem]">
                            <button @onclick="() => Raise(item)"
                                    class="px-2.5 py-1 border border-black/15 text-[#1A1A1A] hover:border-[#1A1A1A] transition-colors">
                                +10
                            </button>
                            <button @onclick="() => Remove(item)"
                                    class="px-2.5 py-1 border border-[#A35C46]/40 text-[#A35C46] hover:bg-[#A35C46] hover:text-white transition-colors ml-auto">
                                Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </main>
</div>

@code {
    private List<ThriftItem> items = new();
    private bool isLoading = true;

    private string newTitle = "";
    private string newCategory = "Outerwear";
    private string newSizeLabel = "";
    private string newCondition = "Good";
    private decimal newPrice;
    private bool saving;

    private readonly string[] categories = ["All", "Outerwear", "Tops", "Bottoms", "Dresses"];
    private readonly string[] conditions = ["All", "Excellent", "Good", "Fair"];

    private string selectedCategory = "All";
    private string selectedCondition = "All";

    private List<ThriftItem> FilteredItems => items
        .Where(x => selectedCategory == "All" || x.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase))
        .Where(x => selectedCondition == "All" || x.Condition.Equals(selectedCondition, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
        => await Load();

    private async Task Load()
    {
        var res = await Db.From<ThriftItem>()
            .Where(x => x.DeletedAt == null)
            .Order(x => x.Id, Ordering.Ascending)
            .Range(0, 49)
            .Get();

        items = res.Models;
        isLoading = false;
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newSizeLabel)) return;

        saving = true;
        await Db.From<ThriftItem>().Insert(new ThriftItem
        {
            Title = newTitle,
            Category = newCategory,
            SizeLabel = newSizeLabel,
            Condition = newCondition,
            Price = newPrice
        });

        newTitle = "";
        newSizeLabel = "";
        newPrice = 0;
        saving = false;
        await Load();
    }

    private async Task Raise(ThriftItem item)      // sends PATCH
    {
        await Db.From<ThriftItem>()
            .Where(x => x.Id == item.Id)
            .Set(x => x.Price, item.Price + 10)
            .Update();
        await Load();
    }

    private async Task Remove(ThriftItem item)     // soft delete
    {
        await Db.From<ThriftItem>()
            .Where(x => x.Id == item.Id)
            .Set(x => x.DeletedAt, DateTime.UtcNow)
            .Update();
        await Load();
    }

    private static string GetButtonClass(bool isActive) => isActive
        ? "bg-[#1A1A1A] text-white px-4 py-1.5 border border-[#1A1A1A] transition-colors"
        : "bg-transparent text-[#1A1A1A] px-4 py-1.5 border border-black/15 hover:border-black/40 transition-colors";
}